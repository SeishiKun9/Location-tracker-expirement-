# ====================================================================
# FRIEND TRACKER - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# Copy this file to '.env' and insert your personal API keys.
# Do NOT commit your actual '.env' file to public Git repositories.
# ====================================================================

# 1. MapTiler (Recommended - 100,000 free loads/month, no credit card required)
# Get a free key in 30 seconds at: https://cloud.maptiler.com/
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE

# 2. Geoapify (Alternative - 3,000 free requests/day, no credit card required)
# Get a free key at: https://www.geoapify.com/
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY_HERE

# 3. Active Map Tile Provider
# Options: 'maptiler', 'geoapify', or 'osm_free' (no key needed)
MAP_PROVIDER=maptiler
